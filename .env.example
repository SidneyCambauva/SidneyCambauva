# Arquivo didatico: modelo de configuracao da SIX.
# Copie para .env e ajuste os valores conforme o servidor ou a escola.

# Nome publico da plataforma.
SIX_PLATFORM_NAME=SIX
# Nome da escola exibido na interface.
SIX_SCHOOL_NAME=Capitao Pedro Monteiro do Amaral
# Apenas esses dominios podem criar conta.
SIX_ALLOWED_EMAIL_DOMAINS=educacao.sp.gov.br,professor.educacao.sp.gov.br
# Porta e IP onde o Node.js escuta.
SIX_PORT=3000
SIX_HOST=0.0.0.0
# Pasta de dados e arquivo SQLite.
SIX_DATA_DIR=./data
SIX_DB_PATH=./data/six.sqlite
# Tempo de sessao, limite de texto e primeira conta admin.
SIX_SESSION_DAYS=14
SIX_MAX_POST_LENGTH=560
SIX_FIRST_USER_ADMIN=true
# Em HTTPS real, deixe true para proteger o cookie.
SIX_COOKIE_SECURE=false

# URL publica quando publicar atras de Nginx em /xis.
SIX_PUBLIC_URL=https://www.capitao.tec.br/xis